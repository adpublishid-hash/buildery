// My Landing — Prisma schema
// Part 1: auth + roles
// Part 2: workspaces, members, invitations, uploads

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

