# =============================================================================
# My Landing — environment variables
# Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env
# =============================================================================

# --- Database ----------------------------------------------------------------
# Local dev example:
#   postgresql://buildery:buildery@localhost:5432/buildery?schema=public
# Production (dedicated DB user, strong password, localhost only):
#   postgresql://buildery:STRONG_PASSWORD@localhost:5432/buildery?schema=public
DATABASE_URL="postgresql://buildery:buildery@localhost:5432/buildery?schema=public"

# --- NextAuth ----------------------------------------------------------------
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET="replace-me-with-a-long-random-string"
# In production this MUST be your public HTTPS URL (no trailing slash):
#   https://buildery.example.com
NEXTAUTH_URL="http://localhost:3000"
# Comma-separated allowlist. Every listed account must also have the
# SUPER_ADMIN database role.
SUPER_ADMIN_EMAILS="wahib.chelsea@gmail.com"
# Local/test only. Production always fails closed when Midtrans is missing.
ALLOW_SIMULATED_PAYMENTS="false"
TRUST_PROXY="false"

# --- Google OAuth (optional) -------------------------------------------------
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Add this Authorized redirect URI in the OAuth client:
#   {NEXTAUTH_URL}/api/auth/callback/google
# For landing.my.id production, use:
#   https://landing.my.id/api/auth/callback/google
# Leave both blank to disable the "Continue with Google" button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="My Landing"
# Public base URL — used for OG metadata, payment callbacks, referral links.
# In production set this to the same HTTPS URL as NEXTAUTH_URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Root domain for hosted user sites. A workspace with slug "acme" is served at:
#   https://acme.landing.my.id
NEXT_PUBLIC_SITE_DOMAIN="landing.my.id"

# --- App notification email --------------------------------------------------
# Platform/admin-to-user emails only: verification codes, workspace invites,
# password/account notices, etc. This is separate from workspace integrations.
# Users still configure their own Mailketing/Gmail in Dashboard > Settings >
# Integrations for buyer/order/form emails.
APP_NOTIFICATION_SMTP_HOST=""
APP_NOTIFICATION_SMTP_PORT="587"
APP_NOTIFICATION_SMTP_SECURE="false"
APP_NOTIFICATION_SMTP_USER=""
APP_NOTIFICATION_SMTP_PASSWORD=""
APP_NOTIFICATION_EMAIL_FROM=""
APP_NOTIFICATION_EMAIL_NAME="My Landing"

# --- Midtrans payment gateway (Part 11) --------------------------------------
# Leave SERVER_KEY/CLIENT_KEY blank for "sandbox-free" mode (payments settle
# instantly — for local testing only). Fill with sandbox keys to test the
# real flow, or production keys for live payments.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
# "true" for production Midtrans, "false" for sandbox.
MIDTRANS_IS_PRODUCTION="false"
# Set this exact URL in the Midtrans dashboard
# (Settings → Configuration → Payment Notification URL):
MIDTRANS_NOTIFICATION_URL="http://localhost:3000/api/payments/midtrans/webhook"

# --- AI assistant (kie.ai — Gemini 3.8 Flash) --------------------------------
# Powers page-section generation in the builder and product copy in the
# product form. Costs the platform operator per call, so access is also gated
# by the SaaS plan flag `hasAiAssistant`.
# Get a key at https://kie.ai — leave blank to hide every AI button.
KIE_API_KEY=""
# Overrides. Defaults shown; the model lives in the URL path, not the body.
# KIE_API_BASE_URL="https://api.kie.ai"
# KIE_MODEL_SLUG="gemini-3-8-flash-openai"

# --- Background jobs ---------------------------------------------------------
# Shared secret between the app and the PM2 ticker (scripts/job-runner.mjs)
# that drains the ScheduledJob queue: abandoned-checkout recovery, retries for
# failed order notifications, periodic sweeps.
# Generate with:  openssl rand -hex 32
# Leave blank to keep /api/jobs/run disabled — queued jobs simply wait.
JOBS_RUNNER_SECRET=""

# Bearer token for POST /api/webhooks/shipping
SHIPPING_WEBHOOK_SECRET=""
# How often the ticker fires, in milliseconds. Default 60000 (one minute).
JOBS_TICK_MS="60000"
# Override only if the app is not on 127.0.0.1:$PORT.
# JOBS_RUNNER_URL="http://127.0.0.1:3011/api/jobs/run"

# --- Runtime -----------------------------------------------------------------
# NODE_ENV is set by the build/start scripts — do not override here.
# PORT is set by PM2 (ecosystem.config.js) — defaults to 3000.

# Signs outgoing form webhooks (X-Buildery-Signature). Optional — falls back
# to NEXTAUTH_SECRET. Set it to rotate webhook signing without invalidating
# every session.
WEBHOOK_SIGNING_SECRET=""

# Optional dedicated affiliate secrets. Both fall back to NEXTAUTH_SECRET.
# Set dedicated values when you need to rotate attribution or payout-field
# encryption independently from user sessions.
AFFILIATE_ATTRIBUTION_SECRET=""
AFFILIATE_PAYOUT_SECRET=""

# ----- Ad platforms (Meta CAPI, TikTok Events API) -----
# Pixel IDs and access tokens are set per workspace in Settings → Integrations.
# Optional: Graph API version for Meta CAPI. Defaults to v26.0; change it when
# Meta retires that version, without a code deploy.
META_GRAPH_API_VERSION=""

# Optional: how many days of raw analytics events to keep. Older rows are
# deleted once their day is summarised in AnalyticsDailyStat, which the charts
# read. Defaults to 180.
ANALYTICS_RAW_RETENTION_DAYS=""
